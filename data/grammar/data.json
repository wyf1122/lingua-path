      },
      {
        "type": "error",
        "question": "找出错误：I walk to school yesterday.",
        "answer": "I walked to school yesterday",
        "options": [
          "I walked to school yesterday",
          "I walk to school yesterday",
          "I walking to school yesterday"
        ]
      }
    ]
  },
  {
    "id": "grammar_test_006",
    "title": "介词的用法 at / in / on",
    "level": "A1",
    "category": "介词",
    "explanation": "at 用于时间点或小地点，in 用于月份或大范围，on 用于具体某天或表面。",
    "rules": [
      "at + 时刻",
      "in + 月份",
      "on + 星期几"
    ],
    "examples": [
      {
        "en": "We meet at six.",
        "zh": "我们六点见面。"
      },
      {
        "en": "I was born in May.",
        "zh": "我出生在五月。"
      }
    ],
    "exercises": [
      {
        "type": "fill",
        "question": "See you ___ Friday.",
        "answer": "on",
        "options": [
          "on",
          "in",
          "at"
        ]
      },
      {
        "type": "fill",
        "question": "The keys are ___ the table.",
        "answer": "on",
        "options": [
          "at",
          "on",
          "in"
        ]
      }
    ]
  },
  {
    "id": "grammar_test_007",
    "title": "代词 I / you / he / she",
    "level": "A1",
    "category": "代词",
    "explanation": "人称代词作主语时位于句首，注意与 be 动词的搭配。",
    "rules": [
      "I am",
      "You / We / They are",
      "He / She / It is"
    ],
    "examples": [
      {
        "en": "I am a student.",
        "zh": "我是一名学生。"
      },
      {
        "en": "She is my sister.",
        "zh": "她是我姐姐。"
      }
    ],
