  {
    "id": "grammar_test_008",
    "title": "否定句的构成",
    "level": "A1",
    "category": "句型",
    "explanation": "一般现在时的否定句借助 don’t / doesn’t，第三人称单数用 doesn’t。",
    "rules": [
      "don’t + 动词原形",
      "doesn’t + 动词原形（第三人称）",
      "be 动词直接加 not"
    ],
    "examples": [
      {
        "en": "I don’t like coffee.",
        "zh": "我不喜欢咖啡。"
      },
