[
  {
    "id": "grammar_test_001",
    "title": "一般现在时",
    "level": "A1",
    "category": "时态",
    "explanation": "一般现在时表示经常发生的动作或客观事实。主语为第三人称单数时，动词加 s/es。",
    "rules": [
      "主语 + 动词原形（第三人称单数加 s）",
      "否定：don’t / doesn’t + 动词原形",
      "疑问：Do / Does 开头"
    ],
    "examples": [
      {
        "en": "I read English every morning.",
        "zh": "我每天早上读英语。"
      },
      {
        "en": "She watches TV at night.",
        "zh": "她晚上看电视。"
      }
    ],
    "exercises": [
      {
        "type": "fill",
        "question": "He ___ play basketball on Sundays.",
        "answer": "plays",
        "options": [
          "play",
          "plays",
          "playing"
        ]
      },
      {
        "type": "error",
        "question": "找出错误：She don’t like coffee.",
        "answer": "She doesn’t like coffee",
        "options": [
          "She don’t like coffee",
          "She doesn’t like coffee",
          "She not like coffee"
        ]
      }
    ]
  },
  {
    "id": "grammar_test_002",
    "title": "There be 句型",
    "level": "A1",
    "category": "句型",
    "explanation": "There be 表示“某处有某物”，be 动词由后面的名词决定单复数。",
    "rules": [
      "There is + 单数名词",
      "There are + 复数名词",
      "否定：There isn’t / aren’t"
    ],
    "examples": [
      {
        "en": "There is a book on the desk.",
        "zh": "桌上有本书。"
      },
      {
        "en": "There are two cats in the garden.",
        "zh": "花园里有两只猫。"
      }
    ],
    "exercises": [
      {
        "type": "fill",
        "question": "There ___ a pen in the box.",
        "answer": "is",
        "options": [
          "is",
          "are",
          "am"
        ]
      },
      {
        "type": "fill",
        "question": "There ___ many students in the hall.",
        "answer": "are",
        "options": [
          "is",
          "are",
          "am"
        ]
      }
    ]
  },
  {
    "id": "grammar_test_003",
    "title": "情态动词 can",
    "level": "A1",
    "category": "情态动词",
    "explanation": "can 表示“能够”，后接动词原形，没有人称与数的变化。",
    "rules": [
      "can + 动词原形",
      "否定：can’t",
      "疑问：Can you …?"
    ],
    "examples": [
      {
        "en": "I can swim very fast.",
        "zh": "我游泳游得很快。"
      },
      {
        "en": "Can you help me?",
        "zh": "你能帮帮我吗？"
      }
    ],
    "exercises": [
      {
